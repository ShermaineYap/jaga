# --- Nebius Token Factory (required for live mode) ---------------------------
# Get $25 with promo code NEBIUS-DEVPOST-GLOBAL26 and another $25 via the Nebius Builders Program.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Nemotron tiers — comma-separated fallback chains. Verify IDs with: python scripts/list_models.py
JAGA_MODEL_FAST=nvidia/Nemotron-3_5-Lightning,nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
JAGA_MODEL_PLAN=nvidia/nemotron-3-super-120b-a12b,nvidia/Nemotron-3_5-Lightning
JAGA_MODEL_ESCALATE=nvidia/Nemotron-3-Ultra-550b-a55b,nvidia/nemotron-3-super-120b-a12b
JAGA_PLAN_BUDGET=2500
JAGA_ESCALATE_BUDGET=6000

# --- Tavily (verification) ------------------------------------------------------
TAVILY_API_KEY=

# --- Telegram (senior + guardian gateway) -------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Runtime ---------------------------------------------------------------------
# 1 = run fully offline with deterministic stand-ins (tests, recorded-run fallback)
JAGA_MOCK=0
JAGA_DB=./data/jaga.sqlite3
JAGA_DEMO_HOUSEHOLD=demo-household
JAGA_RATE_LIMIT=10
